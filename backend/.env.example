# Copy to backend/.env and fill the blanks. Do not commit .env.
# Node 20+: node --env-file=.env server.js

# Public CloudBase environment. SMS login is already enabled in the console.
CLOUDBASE_ENV_ID=translatehud-d4gl951eo8bef4702

# Server-held translation key. The Mac app never sees this.
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_MODEL=deepseek-v4-flash

# Yuan per 1,000,000 tokens, kept to 0.000001 yuan (one micro-yuan). The ledger
# stores integer micro-yuan. A charge is the floor of tokens × this rate /
# 1,000,000, so a short call is not rounded up to ¥0.01 and there is no 1-fen
# minimum. The app still shows fen (¥0.01), rounded half-up for display only.
# Defaults are DeepSeek Flash peak rates (2026-10): cache-miss input ¥2,
# cache-hit input ¥0.04, output ¥8. Off-peak is about half.
# Change these when the model or the provider bill changes. Leave blank to keep
# the default. Set the cache-hit price equal to the input price to skip the
# cache discount. Tokens are billed at the input price unless the response
# reports prompt_cache_hit_tokens or prompt_tokens_details.cached_tokens.
TRIAL_PRICE_INPUT_YUAN_PER_MILLION=2
TRIAL_PRICE_CACHE_HIT_YUAN_PER_MILLION=0.04
TRIAL_PRICE_OUTPUT_YUAN_PER_MILLION=8

# memory | file | cloudbase
# Local try-out can use file. Production must use cloudbase so the invite
# redeem count survives restarts and is shared by every instance.
TRIAL_STORE=file
TRIAL_DATA_FILE=./data/accounts.json

# Public invite code shown on the download page. Leave blank to keep the
# built-in default translatehud-200. Set this only to replace that code.
# The value is not a secret: GET /v1/trial/invite-status returns it.
TRIAL_INVITE_CODE=
# How many successful redeems are allowed. Default 200 (about ¥400).
# trial_invite/config.maxRedeems can raise this without a code change.
# The larger of the two values is used.
TRIAL_INVITE_MAX_REDEEMS=200

# Only when TRIAL_STORE=cloudbase and this process is NOT already inside a
# CloudBase function (云托管 / your own VM). Never commit the real values.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

PORT=8787
