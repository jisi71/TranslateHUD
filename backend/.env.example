# Copy to backend/.env and fill the blanks. Do not commit .env.
# Node 20+: node --env-file=.env server.js

# Public CloudBase environment. SMS login is already enabled in the console.
CLOUDBASE_ENV_ID=translatehud-d4gl951eo8bef4702

# Server-held translation key. The Mac app never sees this.
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_MODEL=deepseek-v4-flash

# Yuan per 1,000,000 tokens. Fractions of a fen round up. At least 1 fen when
# usage is greater than zero. Defaults are DeepSeek Flash peak rates (2026-10):
# cache-miss input ¥2, cache-hit input ¥0.04, output ¥8. Off-peak is about half.
# Change these when the model or the provider bill changes. Leave blank to keep
# the default. Set the cache-hit price equal to the input price to skip the
# cache discount. Tokens are billed at the input price unless the response
# reports prompt_cache_hit_tokens or prompt_tokens_details.cached_tokens.
TRIAL_PRICE_INPUT_YUAN_PER_MILLION=2
TRIAL_PRICE_CACHE_HIT_YUAN_PER_MILLION=0.04
TRIAL_PRICE_OUTPUT_YUAN_PER_MILLION=8

# memory | file | cloudbase
# Local try-out can use file. Production must use cloudbase so the ¥2 gift
# survives restarts and is shared by every instance.
TRIAL_STORE=file
TRIAL_DATA_FILE=./data/accounts.json

# Only when TRIAL_STORE=cloudbase and this process is NOT already inside a
# CloudBase function (云托管 / your own VM). Never commit the real values.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

PORT=8787
