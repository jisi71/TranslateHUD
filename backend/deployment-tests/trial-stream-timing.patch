+function translationTiming(res) {
+  const started = performance.now()
+  let since = started
+  let phase = 'body_read_ms'
+  const durations = {}
+  const round = (ms) => Math.round(ms * 1000) / 1000
+  const timing = {
+    stream: false,
+    step(next, at = performance.now()) {
+      durations[phase] = round(at - since)
+      since = at
+      phase = next
+    }
+  }
+  res.once('finish', () => {
+    if (timing.stream) return
+    const ended = performance.now()
+    timing.step(null, ended)
+    console.info(JSON.stringify({
+      event: 'trial_translate_timing',
+      status: res.statusCode,
+      total_ms: round(ended - started),
+      ...durations
+    }))
+  })
+  return timing
+}
