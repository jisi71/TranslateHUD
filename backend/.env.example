# Copy to backend/.env and fill the blanks. Do not commit .env.
# Node 20+: node --env-file=.env server.js

# Public CloudBase environment. SMS login is already enabled in the console.
CLOUDBASE_ENV_ID=translatehud-d4gl951eo8bef4702

# Server-held translation key. The Mac app never sees this.
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_MODEL=deepseek-v4-flash

# memory | file | cloudbase
# Local try-out can use file. Production must use cloudbase so the ¥2 gift
# survives restarts and is shared by every instance.
TRIAL_STORE=file
TRIAL_DATA_FILE=./data/accounts.json

# Only when TRIAL_STORE=cloudbase and this process is NOT already inside a
# CloudBase function (云托管 / your own VM). Never commit the real values.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

PORT=8787
