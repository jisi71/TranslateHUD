{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@总耗时超过 %@ 秒，已停止请求。请缩短原文或更换模型后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@总耗时超过 %@ 秒，已停止请求。请缩短原文或更换模型后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exceeded %@ seconds and was stopped. Shorten the text or choose another model."
          }
        }
      }
    },
    "%@等待超过 %@ 秒，已停止请求。请稍后重试，或缩短原文、选择响应更快的模型。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@等待超过 %@ 秒，已停止请求。请稍后重试，或缩短原文、选择响应更快的模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ took longer than %@ seconds and was stopped. Retry, shorten the text, or choose a faster model."
          }
        }
      }
    },
    "%@（%@ · 特效）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
